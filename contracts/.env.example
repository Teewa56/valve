# Arbitrum Sepolia RPC and USDC configuration
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_USDC=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Set these after running Deploy.s.sol
VALVE_REGISTRY_PROXY=0xYOUR_REGISTRY_PROXY
VALVE_VAULT_PROXY=0xYOUR_VAULT_PROXY

# Required only for Upgrade.s.sol
VALVE_REGISTRY_IMPLEMENTATION=0xNEW_REGISTRY_IMPLEMENTATION
VALVE_VAULT_IMPLEMENTATION=0xNEW_VAULT_IMPLEMENTATION

# Required only for Seed.s.sol (rate uses USDC base units / second, scaled by 1e18)
SEED_PROVIDER=0xPROVIDER_ADDRESS
SEED_RATE_PER_SECOND_X18=11574074074074074074074
SEED_DEPOSIT_AMOUNT=30000000
